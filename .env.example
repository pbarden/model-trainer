# Model Tea Configuration
# Copy this file to .env and modify as needed
# All settings have defaults and are optional

# ============================================================================
# Model Configuration
# ============================================================================

# Base model for training (default: distilgpt2)
# MODEL_TEA_BASE_MODEL=distilgpt2

# Base model for iterative training (default: distilgpt2)
# MODEL_TEA_ITERATIVE_BASE_MODEL=distilgpt2

# Maximum sequence length (default: 1024)
# MODEL_TEA_MAX_SEQ_LENGTH=1024

# Maximum sequence length for iterative training (default: 512)
# MODEL_TEA_ITERATIVE_MAX_SEQ_LENGTH=512

# ============================================================================
# Training Configuration
# ============================================================================

# Learning rate start (default: 5e-5)
# MODEL_TEA_LEARNING_RATE_START=5e-5

# Learning rate end (default: 5e-6)
# MODEL_TEA_LEARNING_RATE_END=5e-6

# Iterative training learning rate start (default: 2e-5)
# MODEL_TEA_ITERATIVE_LEARNING_RATE_START=2e-5

# Iterative training learning rate end (default: 5e-6)
# MODEL_TEA_ITERATIVE_LEARNING_RATE_END=5e-6

# Iterations per novel (default: 12)
# MODEL_TEA_ITERATIONS_PER_NOVEL=12

# Max steps per iteration - basic (default: 20)
# MODEL_TEA_MAX_STEPS_PER_ITERATION=20

# Max steps per iteration - iterative (default: 125)
# MODEL_TEA_ITERATIVE_MAX_STEPS=125

# Warmup steps (default: 5)
# MODEL_TEA_WARMUP_STEPS=5

# Warmup ratio for iterative training (default: 0.15)
# MODEL_TEA_WARMUP_RATIO=0.15

# Batch size (default: 8)
# MODEL_TEA_BATCH_SIZE=8

# Gradient accumulation steps (default: 2)
# MODEL_TEA_GRADIENT_ACCUMULATION_STEPS=2

# Chunk size for basic training (default: 200)
# MODEL_TEA_CHUNK_SIZE=200

# Chunk size for iterative training (default: 150)
# MODEL_TEA_ITERATIVE_CHUNK_SIZE=150

# Chunk overlap (default: 30)
# MODEL_TEA_CHUNK_OVERLAP=30

# Validation split - basic (default: 0.2)
# MODEL_TEA_VALIDATION_SPLIT=0.2

# Validation split - iterative (default: 0.15)
# MODEL_TEA_ITERATIVE_VALIDATION_SPLIT=0.15

# ============================================================================
# LoRA Configuration
# ============================================================================

# Enable LoRA (default: true)
# MODEL_TEA_USE_LORA=true

# LoRA rank (default: 8)
# MODEL_TEA_LORA_R=8

# LoRA alpha (default: 16)
# MODEL_TEA_LORA_ALPHA=16

# LoRA dropout (default: 0.05)
# MODEL_TEA_LORA_DROPOUT=0.05

# LoRA target modules (comma-separated, default: c_attn,c_proj)
# MODEL_TEA_LORA_TARGET_MODULES=c_attn,c_proj

# ============================================================================
# Quality Thresholds
# ============================================================================

# Perplexity threshold - basic (default: 50.0)
# MODEL_TEA_PERPLEXITY_THRESHOLD=50.0

# Perplexity threshold - iterative (default: 20.0)
# MODEL_TEA_ITERATIVE_PERPLEXITY_THRESHOLD=20.0

# Target perplexity (default: 15.0)
# MODEL_TEA_TARGET_PERPLEXITY=15.0

# Quality threshold (default: 0.8)
# MODEL_TEA_QUALITY_THRESHOLD=0.8

# Perplexity improvement threshold (default: 2.0)
# MODEL_TEA_PERPLEXITY_IMPROVEMENT_THRESHOLD=2.0

# Quality degradation threshold (default: 0.01)
# MODEL_TEA_QUALITY_DEGRADATION_THRESHOLD=0.01

# ============================================================================
# Adaptive Training
# ============================================================================

# Enable adaptive training (default: true)
# MODEL_TEA_ADAPTIVE_TRAINING=true

# Early stopping patience (default: 3)
# MODEL_TEA_EARLY_STOPPING_PATIENCE=3

# Overfitting detection window (default: 3)
# MODEL_TEA_OVERFITTING_DETECTION_WINDOW=3

# Validation loss patience (default: 3)
# MODEL_TEA_VALIDATION_LOSS_PATIENCE=3

# Minimum iterations (default: 5)
# MODEL_TEA_MIN_ITERATIONS=5

# Maximum iterations (default: 50)
# MODEL_TEA_MAX_ITERATIONS=50

# ============================================================================
# Generation Configuration
# ============================================================================

# Default max generation length (default: 250)
# MODEL_TEA_DEFAULT_MAX_LENGTH=250

# Default generation temperature (default: 0.5)
# MODEL_TEA_DEFAULT_TEMPERATURE=0.5

# Validation temperature (default: 0.8)
# MODEL_TEA_VALIDATION_TEMPERATURE=0.8

# Max repetition penalty (default: 1.1)
# MODEL_TEA_MAX_REPETITION_PENALTY=1.1

# Temperature range min (default: 0.7)
# MODEL_TEA_TEMPERATURE_RANGE_MIN=0.7

# Temperature range max (default: 0.9)
# MODEL_TEA_TEMPERATURE_RANGE_MAX=0.9

# ============================================================================
# Path Configuration
# ============================================================================

# Novels directory (default: novels)
# MODEL_TEA_NOVELS_DIR=novels

# Models metadata file (default: models.json)
# MODEL_TEA_MODELS_FILE=models.json

# Novels metadata file (default: novels.json)
# MODEL_TEA_NOVELS_FILE=novels.json

# Output directory for trained models (default: iterative_models)
# MODEL_TEA_OUTPUT_DIR=iterative_models

# Save checkpoints (default: true)
# MODEL_TEA_SAVE_CHECKPOINTS=true

# ============================================================================
# API Configuration
# ============================================================================

# API server host (default: 0.0.0.0)
# MODEL_TEA_API_HOST=0.0.0.0

# API server port (default: 8000)
# MODEL_TEA_API_PORT=8000

# CORS allowed origins (comma-separated, default: *)
# For production, specify actual origins:
# MODEL_TEA_API_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
# MODEL_TEA_LOG_LEVEL=INFO
